{
  "name": "manual-qa-machine",
  "version": "0.2.0",
  "description": "AI-powered manual QA testing with screenshots at every step via agent-browser. Claude Code plugin + standalone CLI.",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "npm@10.9.2",
  "bin": {
    "mqm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "spell": "npx cspell lint --no-progress README.md src commands skills test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "qa",
    "testing",
    "screenshots",
    "agent-browser",
    "claude-code",
    "manual-testing",
    "visual-testing",
    "browser-automation"
  ],
  "author": "Calvin Kennedy",
  "license": "MIT",
  "dependencies": {
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "yargs": "^17.7.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@45ck/agent-docs": "github:45ck/agent-docs",
    "@45ck/noslop": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/yargs": "^17.0.33",
    "cspell": "^9.7.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin"
  ]
}
